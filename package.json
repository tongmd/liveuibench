{
  "name": "guios",
  "version": "1.0.0",
  "description": "Agent-native cross-platform application runtime driven by app specs and agent backends.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "index.js",
  "scripts": {
    "test": "tsx server/smoke-test.ts",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=8787 DB_PATH=./data/guios.db GENERATED_APPS_DIR=./generated-apps GUIOS_ORCHESTRATOR_MODEL=gpt-5.4 tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "PORT=8787 DB_PATH=./data/guios.db GENERATED_APPS_DIR=./generated-apps GUIOS_ORCHESTRATOR_MODEL=gpt-5.4 node dist-server/server/index.js",
    "deploy:mac": "bash scripts/deploy-macos.sh",
    "check:mac": "tsx server/mac-deploy-check.ts",
    "shell:web": "npm --workspace apps/shell run web",
    "shell:ios": "npm --workspace apps/shell run ios",
    "shell:android": "npm --workspace apps/shell run android",
    "shell:export-web": "cd apps/shell && npx expo export --platform web --output-dir ../../dist-expo-shell",
    "test:cross-platform": "tsx server/cross-platform-test.ts",
    "benchmark:intents": "tsx server/intention-benchmark.ts",
    "benchmark:workflowgen": "tsx server/workflowgen-benchmark.ts",
    "benchmark:workflowgen:6k": "node scripts/workflowgen/generate-livegui-bench-6k.cjs benchmarks/workflowgen/cases.livegui-bench-6k.json && node scripts/workflowgen/summarize-benchmark.cjs benchmarks/workflowgen/cases.livegui-bench-6k.json artifacts/workflowgen/livegui-bench-6k",
    "benchmark:workflowgen:summary": "node scripts/workflowgen/summarize-run.cjs",
    "paper:claim-traceability": "node scripts/workflowgen/write-claim-traceability.cjs",
    "paper:release-governance": "node scripts/workflowgen/write-release-governance.cjs",
    "paper:reported-runs": "node scripts/workflowgen/write-reported-runs-manifest.cjs",
    "paper:public600": "node scripts/workflowgen/write-public600-sweep.cjs && node scripts/workflowgen/write-family-difficulty.cjs",
    "paper:figure-manifest": "node scripts/figures/write-paper-figure-manifest.cjs",
    "paper:chi-study-results": "node scripts/chi/analyze-study-results.cjs",
    "paper:chi-results-figure": "python3 scripts/figures/write-chi-results-figure.py",
    "paper:readiness": "node scripts/papers/check-paper-readiness.cjs",
    "paper:readiness:iclr": "node scripts/papers/check-paper-readiness.cjs --paper iclr2027-liveguibench",
    "paper:check": "npm run paper:figure-manifest && npm run paper:reported-runs && npm run paper:claim-traceability && npm run paper:release-governance && node scripts/papers/check-paper-assets.cjs && npm run paper:readiness",
    "paper:check:iclr": "npm run paper:figure-manifest && npm run paper:reported-runs && npm run paper:public600 && npm run paper:claim-traceability && npm run paper:release-governance && node scripts/papers/check-paper-assets.cjs --paper iclr2027-liveguibench && npm run paper:readiness:iclr",
    "test:route-10": "tsx server/agent-route-10-test.ts",
    "test:app-quality": "tsx server/app-quality-test.ts",
    "test:scheduler": "tsx server/agent-scheduler-test.ts",
    "test:appworld-bridge": "tsx server/appworld-bridge.test.ts",
    "evaluator:behavior": "tsx server/evaluator-agent.ts",
    "evaluator:gui": "tsx server/gui-evaluator-agent.ts",
    "audit:visual": "tsx server/visual-audit.ts",
    "audit:gallery": "tsx server/gallery-visual-audit.ts",
    "evaluator:trajectory": "node scripts/evaluator/render-trajectory.cjs",
    "paper:main-table": "node scripts/workflowgen/write-main-results-table.cjs",
    "paper:failure-table": "node scripts/workflowgen/write-failure-taxonomy-table.cjs",
    "benchmark:appworld": "tsx server/appworld-bench.ts",
    "paper:appworld-table": "node scripts/workflowgen/write-appworld-bench-table.cjs",
    "paper:dataset-stats": "node scripts/livegui/write-dataset-stats.cjs"
  },
  "keywords": [
    "guios",
    "agent-runtime",
    "app-spec",
    "dynamic-renderer",
    "cross-platform"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "puppeteer-core": "^25.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
