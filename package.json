{
  "name": "liveuibench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "LiveUIBench evaluation data, isolated runners, and metrics.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "npm ci && npm --prefix liveuiagent ci --workspace @liveuiagent/dsh-plugin --include-workspace-root --no-audit --no-fund",
    "build": "npm --prefix liveuiagent run build",
    "test": "tsx --test tests/*.test.ts",
    "test:liveuibench": "tsx --test tests/*.test.ts",
    "bench:liveui": "tsx scripts/liveuibench/run.ts",
    "bench:parallel": "tsx scripts/liveuibench/parallel.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "puppeteer-core": "^25.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
